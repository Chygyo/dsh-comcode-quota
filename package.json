{
  "name": "dsh-comcode-quota",
  "description": "Command Code (GOAT) quota monitor inside DeepSeek Harness: 5-hour / weekly / monthly credit windows, burn-rate projection, model pricing calculator and sampling history.",
  "version": "1.0.8",
  "icon": "icon.svg",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/en.json": "./locale/en.json",
    "./locale/zh.json": "./locale/zh.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.2.2-rc.3"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/dsh": ">=0.2.2-rc.3 <0.3.0-0 || >=0.2.3-0 <0.3.0-0",
    "react": "^18.2.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "lib/**/*.js",
    "data/goat-pricing.json",
    "locale/*.json",
    "docs",
    "icon.svg",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chygyo/dsh-comcode-quota.git"
  },
  "homepage": "https://github.com/Chygyo/dsh-comcode-quota#readme",
  "bugs": {
    "url": "https://github.com/Chygyo/dsh-comcode-quota/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "command-code",
    "quota",
    "usage",
    "credits"
  ]
}
